# ===== Unreal Engine (official template) =====
# Patterns with a "/" are anchored to the repo root. The UE project lives in
# "Game_01 5.8/" (see the subfolder section below), so generated folders are
# ignored at any depth there.

# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Per-user editor settings (local to each developer, e.g. MCP port config)
**/Config/DefaultEditorPerProjectUserSettings.ini

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# ===== UE project in a subfolder =====
# The template patterns above are anchored to the repo root. The jam project lives
# in "Game_01 5.8/", so ignore its generated folders at any depth (Intermediate alone
# was 2.7 GB).
**/Binaries/
**/Intermediate/
**/Saved/
**/DerivedDataCache/

# ===== Project-specific =====

# Pre-jam warm-up UE project (made 11/6-11/7, before the jam start).
# Must not enter this repo; the jam project is "Game_01 5.8/".
Game_Jam_01/

# macOS
.DS_Store

# Claude Code local
.claude/settings.local.json

# CCGS session state and logs (local, ephemeral)
production/session-state/
production/session-logs/

# Obsidian per-user workspace layout
.obsidian/workspace*.json

# Scratch files from local build/MCP/PR helper scripts
.tmp/
.screenshots/
